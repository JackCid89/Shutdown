---
import type { SiteContent } from '../content.config';
interface SourceRef { outlet: string; url: string; author?: string }
interface Props { sources: SourceRef[]; ui: SiteContent['ui'] }
const { sources, ui } = Astro.props;
if (!sources?.length) return null;
---
<details class="mt-6 border-s border-ink/15 ps-4 [&[open]>summary>span:last-child]:rotate-180">
  <summary class="cursor-pointer list-none font-mono text-[0.7rem] uppercase tracking-wider text-ink/60 hover:text-ink">
    <span>{ui.show_sources}</span>
    <span class="ms-1 inline-block transition" aria-hidden="true">▾</span>
  </summary>
  <ul role="list" class="mt-3 space-y-1.5 font-mono text-[0.78rem] leading-snug">
    {sources.map((s) => (
      <li>
        {s.url ? (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-blood underline decoration-blood/30 underline-offset-4 hover:decoration-blood">
            {s.outlet}
            {s.author && <span class="opacity-60"> · {s.author}</span>}
            <span aria-hidden="true" class="ms-1 opacity-60">↗</span>
          </a>
        ) : (
          <span>{s.outlet}</span>
        )}
      </li>
    ))}
  </ul>
</details>
