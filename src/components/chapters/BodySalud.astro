---
import SourceList from '../SourceList.astro';
import type { SiteContent } from '../../content.config';
interface Props { chapter: SiteContent['chapters'][number]; ui: SiteContent['ui'] }
const { chapter, ui } = Astro.props;
---
{chapter.key_facts && (
  <div class="grid gap-6 lg:grid-cols-2">
    {chapter.key_facts.map((kf) => (
      <article class="border border-ink/15 bg-paper/40 p-6">
        <p class="meta mb-2 text-blood">{kf.year}</p>
        <p class="text-base leading-relaxed sm:text-lg">{kf.fact}</p>
        <p class="mt-4 font-mono text-[0.72rem] uppercase tracking-wider text-ink/60">
          — {kf.source}
        </p>
        <p class="mt-1">
          <a href={kf.url} target="_blank" rel="noopener noreferrer" class="font-mono text-[0.72rem] text-blood underline underline-offset-4">
            ↗ {kf.outlet}
          </a>
        </p>
      </article>
    ))}
  </div>
)}

{chapter.internal_documents && (
  <section class="mt-14 border-t border-ink/30 pt-10">
    <h3 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
      {chapter.internal_documents.title}
    </h3>
    <p class="mt-3 max-w-3xl text-base leading-relaxed sm:text-lg">
      {chapter.internal_documents.context}
    </p>
    <ul role="list" class="mt-6 space-y-3 border-s-4 border-blood ps-5">
      {chapter.internal_documents.findings.map((f) => (
        <li class="flex gap-3 text-base sm:text-lg">
          <span class="mt-2 inline-block size-1.5 shrink-0 bg-ink" aria-hidden="true"></span>
          <span>{f}</span>
        </li>
      ))}
    </ul>
    <SourceList sources={chapter.internal_documents.sources} ui={ui} />
  </section>
)}
