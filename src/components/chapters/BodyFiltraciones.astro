---
import SourceList from '../SourceList.astro';
import DataBlock from '../DataBlock.astro';
import type { SiteContent } from '../../content.config';
interface Props { chapter: SiteContent['chapters'][number]; ui: SiteContent['ui'] }
const { chapter, ui } = Astro.props;
const hb = chapter.headline_breach;
---
{hb && (
  <section class="border border-ink/30 bg-paper/40 p-6 sm:p-10">
    <p class="meta mb-3 inline-block bg-ink px-2 py-1 text-bone">2021</p>
    <h3 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
      {hb.title}
    </h3>

    <div class="my-8 grid gap-6 sm:grid-cols-3">
      <DataBlock value="533M" label={hb.scale} tone="blood" />
      <DataBlock value="106" label="países" />
      <DataBlock value="0" label="usuarios notificados" tone="blood" />
    </div>

    <h4 class="mb-3 font-mono text-xs uppercase tracking-wider text-ink/60">datos expuestos</h4>
    <ul role="list" class="mb-6 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {hb.data_exposed.map((d) => (
        <li class="border-s-2 border-blood ps-3 text-sm">{d}</li>
      ))}
    </ul>

    <p class="mt-4 border-s-4 border-blood ps-5 font-display text-xl italic leading-snug">
      {hb.outrage}
    </p>
    <p class="mt-5 text-base leading-relaxed sm:text-lg">{hb.why_phone_numbers_matter}</p>
    <p class="mt-3 text-base leading-relaxed sm:text-lg">{hb.free_distribution}</p>

    <SourceList sources={hb.sources} ui={ui} />
  </section>
)}

{chapter.breach_timeline && (
  <section class="mt-14">
    <h3 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Timeline</h3>
    <ol role="list" class="relative mt-8 border-s-2 border-blood">
      {chapter.breach_timeline.map((t) => (
        <li class="relative ms-6 pb-8">
          <span class="absolute -start-[1.95rem] top-1 inline-block size-3 rounded-full bg-blood ring-4 ring-bone" aria-hidden="true"></span>
          <p class="font-display text-3xl font-black leading-none text-blood">{t.year}</p>
          <p class="mt-1 font-display text-xl font-semibold">{t.event}</p>
          <p class="meta mt-1 text-ink/60">{t.scale}</p>
          <p class="mt-2 max-w-2xl text-base leading-relaxed">{t.detail}</p>
        </li>
      ))}
    </ol>
    {chapter.sources_timeline && <SourceList sources={chapter.sources_timeline} ui={ui} />}
  </section>
)}

{chapter.self_check && (
  <aside class="mt-14 border border-blood bg-blood/5 p-6 sm:p-8">
    <p class="meta mb-2 text-blood">{chapter.self_check.title}</p>
    <h4 class="font-display text-2xl font-bold sm:text-3xl">
      <a href={chapter.self_check.url} target="_blank" rel="noopener noreferrer" class="underline decoration-blood/40 decoration-2 underline-offset-4 hover:decoration-blood">
        ↗ {chapter.self_check.tool_name}
      </a>
    </h4>
    <p class="mt-3 max-w-2xl text-base leading-relaxed sm:text-lg">{chapter.self_check.description}</p>
  </aside>
)}
