---
interface Props { cite?: string; lang?: string }
const { cite, lang } = Astro.props;
---
<figure class="my-8 border-s-4 border-blood ps-5 sm:ps-6">
  <blockquote lang={lang} class="font-display text-xl italic leading-snug text-ink sm:text-2xl">
    <slot />
  </blockquote>
  {cite && (
    <figcaption class="mt-3 font-mono text-[0.72rem] uppercase tracking-wider text-ink/60">
      — {cite}
    </figcaption>
  )}
</figure>
