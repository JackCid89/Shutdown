---
import type { SiteContent } from '../content.config';
interface Props { content: SiteContent }
const { content } = Astro.props;
const m = content.manifesto;
---
<section id="manifiesto" class="border-b border-ink/30">
  <div class="mx-auto max-w-screen-xl px-4 py-20 sm:px-6">
    <header class="mb-12 max-w-3xl">
      <h2 class="font-display text-[clamp(2rem,5vw,3.75rem)] font-bold tracking-tight">{m.title}</h2>
      <p class="mt-3 font-display text-xl italic text-rust sm:text-2xl">{m.subtitle}</p>
    </header>
    <ol role="list" class="grid gap-x-12 gap-y-8 md:grid-cols-2">
      {m.items.map((it) => (
        <li class="grid grid-cols-[auto_1fr] items-baseline gap-5 border-t border-ink/20 pt-6">
          <span class="font-display text-5xl font-black leading-none text-blood sm:text-6xl">{String(it.n).padStart(2,'0')}</span>
          <p class="text-base leading-relaxed sm:text-lg">{it.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
