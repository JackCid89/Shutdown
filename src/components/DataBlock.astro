---
interface Props { value: string; label: string; tone?: 'default' | 'blood' | 'inverse' }
const { value, label, tone = 'default' } = Astro.props;
const cls = tone === 'blood'
  ? 'text-blood'
  : tone === 'inverse'
    ? 'text-bone bg-ink p-6'
    : 'text-ink';
---
<div class:list={['flex flex-col gap-1', cls]}>
  <p class="font-display text-[clamp(2.5rem,7vw,5rem)] font-black leading-none tracking-tight">
    {value}
  </p>
  <p class="meta opacity-70">{label}</p>
</div>
